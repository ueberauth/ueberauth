{application,quic,
             [{description,"Pure Erlang QUIC implementation (RFC 9000)"},
              {vsn,"2.1.3"},
              {registered,[quic_sup,quic_server_registry,quic_server_sup,
                           quic_token_cache,quic_conn_sup,quic_happy_sup,
                           quic_dist_sup,quic_dist_tickets]},
              {mod,{quic_app,[]}},
              {applications,[kernel,stdlib,crypto,ssl]},
              {env,[]},
              {modules,[quic,quic_ack,quic_address_token,quic_aead,
                        quic_aead_ctx,quic_app,quic_cc,quic_cc_bbr,
                        quic_cc_cubic,quic_cc_newreno,quic_cert,quic_cid,
                        quic_conn_sup,quic_connection,quic_crypto,
                        quic_crypto_nif,quic_discovery,quic_discovery_dns,
                        quic_discovery_static,quic_dist,quic_dist_auth,
                        quic_dist_controller,quic_dist_dispatch,quic_dist_sup,
                        quic_dist_tickets,quic_epmd,quic_flow,quic_frame,
                        quic_h3,quic_h3_capsule,quic_h3_client,
                        quic_h3_connection,quic_h3_frame,quic_h3_server,
                        quic_happy,quic_happy_sup,quic_hkdf,
                        quic_interop_client,quic_interop_server,quic_interval,
                        quic_keylog,quic_keys,quic_lb,quic_listener,
                        quic_listener_manager,quic_listener_sup,
                        quic_listener_sup_sup,quic_log,quic_loss,quic_packet,
                        quic_pmtu,quic_pqueue,quic_qlog,quic_qpack,
                        quic_qpack_huffman,quic_qpack_prefix,quic_reassembly,
                        quic_rtt,quic_server_registry,quic_server_sup,
                        quic_socket,quic_stream,quic_sup,quic_ticket,quic_tls,
                        quic_tls_negotiation,quic_token_cache,quic_varint]},
              {licenses,["Apache-2.0"]},
              {include_paths,["docs/images/enki-multimedia.svg"]},
              {exclude_paths,["c_src/build"]},
              {links,[{"GitHub","https://github.com/benoitc/erlang_quic"}]}]}.
