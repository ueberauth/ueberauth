{erl_opts,[debug_info,warn_export_vars,warn_shadow_vars,warn_obsolete_guard,
           {platform_define,"^[0-9]+",namespaced_types}]}.
{src_dirs,["src","src/dist","src/interop","src/qpack","src/h3"]}.
{minimum_otp_vsn,"26"}.
{deps,[]}.
{pre_hooks,[{"(linux|darwin|solaris)",compile,"sh c_src/build_nif.sh"},
            {"(freebsd|netbsd|openbsd)",compile,"sh c_src/build_nif.sh"}]}.
{post_hooks,[{"(linux|darwin|solaris)",clean,"sh c_src/build_nif.sh clean"},
             {"(freebsd|netbsd|openbsd)",clean,
              "sh c_src/build_nif.sh clean"}]}.
{profiles,
    [{test,
         [{deps,[{proper,"1.4.0"},{meck,"1.2.0"}]},
          {erl_opts,[debug_info,nowarn_export_all]}]},
     {interop_client,
         [{escript_main_app,quic},
          {escript_name,quic_interop_client},
          {escript_emu_args,"%%! -escript main quic_interop_client\n"}]},
     {interop_server,
         [{escript_main_app,quic},
          {escript_name,quic_interop_server},
          {escript_emu_args,"%%! -escript main quic_interop_server\n"}]},
     {h3_client,
         [{escript_main_app,quic},
          {escript_name,quic_h3_client},
          {escript_emu_args,"%%! -escript main quic_h3_client\n"}]},
     {h3_server,
         [{escript_main_app,quic},
          {escript_name,quic_h3_server},
          {escript_emu_args,"%%! -escript main quic_h3_server\n"}]},
     {dist_node,
         [{relx,
              [{release,{quic_node,"0.1.0"},[quic,sasl]},
               {mode,prod},
               {include_erts,true},
               {extended_start_script,true},
               {sys_config_src,"config/dist_sys.config.src"},
               {vm_args_src,"config/dist_vm.args.src"}]}]}]}.
{hex,[{doc,ex_doc}]}.
{ex_doc,[{source_url,<<"https://github.com/benoitc/erlang_quic">>},
         {extras,[<<"README.md">>,<<"CHANGELOG.md">>,<<"CONTRIBUTING.md">>,
                  <<"docs/MODULE_MAP.md">>,<<"docs/SEND_PATH.md">>,
                  <<"docs/RECV_PATH.md">>,<<"docs/GLOSSARY.md">>,
                  <<"docs/GETTING_STARTED.md">>,<<"docs/DEVELOPER_GUIDE.md">>,
                  <<"docs/features.md">>,<<"docs/DESIGN.md">>,
                  <<"docs/SERVER_GUIDE.md">>,<<"docs/CLIENT_GUIDE.md">>,
                  <<"docs/QUIC_DIST.md">>,<<"docs/PSK.md">>,
                  <<"docs/INTERNAL_NETWORKS.md">>,<<"docs/QLOG_GUIDE.md">>,
                  <<"docs/HTTP3.md">>,<<"docs/PERFORMANCE.md">>]},
         {groups_for_extras,[{<<"Guides">>,
                              [<<"docs/GETTING_STARTED.md">>,
                               <<"docs/DEVELOPER_GUIDE.md">>,
                               <<"docs/CLIENT_GUIDE.md">>,
                               <<"docs/SERVER_GUIDE.md">>]},
                             {<<"Contributing">>,
                              [<<"CONTRIBUTING.md">>,<<"docs/MODULE_MAP.md">>,
                               <<"docs/SEND_PATH.md">>,
                               <<"docs/RECV_PATH.md">>,
                               <<"docs/GLOSSARY.md">>]},
                             {<<"Reference">>,
                              [<<"docs/features.md">>,<<"docs/DESIGN.md">>,
                               <<"docs/PERFORMANCE.md">>]},
                             {<<"Advanced">>,
                              [<<"docs/QUIC_DIST.md">>,<<"docs/PSK.md">>,
                               <<"docs/INTERNAL_NETWORKS.md">>,
                               <<"docs/QLOG_GUIDE.md">>,
                               <<"docs/HTTP3.md">>]}]},
         {main,<<"readme">>},
         {groups_for_modules,[{<<"Public API">>,[quic,quic_listener]},
                              {<<"Connection">>,
                               [quic_connection,quic_cid,quic_stream,
                                quic_pqueue,quic_reassembly,quic_interval]},
                              {<<"Protocol">>,
                               [quic_packet,quic_frame,quic_varint]},
                              {<<"Cryptography">>,
                               [quic_crypto,quic_tls,quic_tls_negotiation,
                                quic_keys,quic_aead,quic_hkdf]},
                              {<<"Flow Control">>,
                               [quic_flow,quic_cc,quic_loss,quic_rtt,
                                quic_ack]},
                              {<<"Session">>,[quic_ticket]},
                              {<<"Distribution">>,
                               [quic_dist,quic_dist_controller,quic_dist_sup,
                                quic_epmd,quic_discovery,
                                quic_discovery_static,quic_discovery_dns,
                                quic_dist_tickets]},
                              {<<"HTTP/3">>,
                               [quic_h3,quic_h3_connection,quic_h3_frame,
                                quic_h3_capsule,quic_h3_client,
                                quic_h3_server]},
                              {<<"QPACK">>,
                               [quic_qpack,quic_qpack_huffman,
                                quic_qpack_prefix]},
                              {<<"Load Balancer">>,[quic_lb]}]}]}.
{erlfmt,[write,
         {files,["{src,test,include,scripts}/**/*.{hrl,erl,app.src,escript}",
                 "src/{qpack,h3}/**/*.{hrl,erl}","erldns.example.config",
                 "rebar.config"]}]}.
{dialyzer,[{warnings,[error_handling,unknown]},
           {plt_apps,all_deps},
           {plt_extra_apps,[crypto,ssl]}]}.
{xref_checks,[undefined_function_calls,undefined_functions,
              deprecated_function_calls,deprecated_functions]}.
{xref_ignores,[{quic_listener,register_cid,3},
               {quic_listener,unregister_cid,2},
               {quic_ticket,create_ticket,5},
               {quic_ticket,build_new_session_ticket,1},
               {quic_dist,listen,1},
               {quic_dist,listen,2},
               {quic_dist,accept,1},
               {quic_dist,accept_connection,5},
               {quic_dist,setup,5},
               {quic_dist,close,1},
               {quic_dist,select,1},
               {quic_dist,address,0},
               {quic_dist,is_node_name,1},
               {quic_dist,acceptor_loop,2},
               {quic_dist,do_setup,6},
               {quic_epmd,start_link,0},
               {quic_epmd,register_node,2},
               {quic_epmd,register_node,3},
               {quic_epmd,port_please,2},
               {quic_epmd,port_please,3},
               {quic_epmd,names,1},
               {quic_epmd,address_please,3},
               {quic_discovery_static,init,1},
               {quic_discovery_static,register,3},
               {quic_discovery_static,lookup,2},
               {quic_discovery_static,list_nodes,1},
               {quic_discovery_dns,init,1},
               {quic_discovery_dns,lookup,2},
               {quic_discovery_dns,list_nodes,1},
               {quic_h3_frame,decode_stream_type,1},
               {quic_h3_frame,is_reserved_frame_type,1},
               {quic_h3_frame,is_reserved_setting,1}]}.
{cover_enabled,true}.
{cover_opts,[verbose]}.
{overrides,[]}.
