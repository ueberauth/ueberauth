{
  "name": "verkit",
  "type": "module",
  "version": "0.5.0",
  "description": "Fast, zero-dependency SemVer for ESM and TypeScript, with functional, tree-shakeable APIs.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/verkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/verkit.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/verkit/issues"
  },
  "keywords": [
    "semver",
    "semantic-versioning",
    "version",
    "range",
    "esm",
    "typescript",
    "functional",
    "immutable"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./comparator": "./dist/comparator.js",
    "./range": "./dist/range.js",
    "./version": "./dist/version.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.3",
    "@types/node": "^26.6.1",
    "@types/semver": "^7.8.0",
    "@typescript/native-preview": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "rolldown": "^1.2.9",
    "semver": "^7.8.5",
    "tsdown": "^0.23.0",
    "tsdown-preset-sxzz": "^0.7.1",
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  },
  "prettier": "@sxzz/prettier-config",
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "bench": "vitest bench --run --experimental.viteModuleRunner=false",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:size": "vitest run tests/bundle-size.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp"
  }
}