{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "elixir",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "package-name": "ueberauth",
      "include-component-in-tag": false,
      "exclude-paths": [
        "strategies"
      ]
    },
    "strategies/ueberauth_apple": {
      "package-name": "ueberauth_apple",
      "component": "ueberauth_apple"
    },
    "strategies/ueberauth_facebook": {
      "package-name": "ueberauth_facebook",
      "component": "ueberauth_facebook"
    },
    "strategies/ueberauth_github": {
      "package-name": "ueberauth_github",
      "component": "ueberauth_github"
    },
    "strategies/ueberauth_google": {
      "package-name": "ueberauth_google",
      "component": "ueberauth_google"
    },
    "strategies/ueberauth_twitter": {
      "package-name": "ueberauth_twitter",
      "component": "ueberauth_twitter"
    }
  }
}
